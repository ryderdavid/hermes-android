<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch: the AndroidX splash (the platform splash on Android 12+),
         on the theme background with the Hermes glyph, so a dark cold start
         never flashes white. -->
    <style name="LaunchTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_glyph</item>
        <item name="postSplashScreenTheme">@style/NormalTheme</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <!-- Behind Flutter while it starts and runs: the same background, drawn
         edge-to-edge under transparent system bars. Flutter sets the bar
         icon brightness per theme once it is running. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
